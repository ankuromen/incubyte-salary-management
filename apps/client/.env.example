# Copy to .env: cp .env.example .env
# Run all client commands from apps/client

# Local dev — Vite proxies /api → backend (see vite.config.ts)
VITE_API_BASE_URL=/api

# Production (Vercel) — Render API root only, NO /api suffix
# VITE_API_BASE_URL=https://salary-management-api.onrender.com

# Without proxy — local API only
# VITE_API_BASE_URL=http://localhost:3000
