# Copy to .env: cp .env.example .env
# Run all client commands from apps/client

# Dev with Vite proxy (recommended — matches vite.config.ts)
VITE_API_BASE_URL=/api

# Production / remote API (set CORS_ORIGIN on server to include http://localhost:5173)
# VITE_API_BASE_URL=https://salary-management-api-production-97a2.up.railway.app

# Without proxy — local API only
# VITE_API_BASE_URL=http://localhost:3000
