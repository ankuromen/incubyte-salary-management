# =============================================================================
# Salary Management — environment variables (monorepo root)
# Copy to .env and adjust for your machine: cp .env.example .env
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# SQLite path is relative to apps/server/prisma/
DATABASE_URL="file:./dev.db"

# --- Client (Vite — only VITE_* vars are exposed to the browser) ---
# Use /api in dev (Vite proxies to the server). Use http://localhost:3000 if not using the proxy.
VITE_API_BASE_URL=/api
